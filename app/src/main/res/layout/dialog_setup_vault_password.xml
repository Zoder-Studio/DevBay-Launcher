<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_settings_card"
    android:padding="20dp">

    <EditText
        android:id="@+id/setupPasswordInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_search_pill"
        android:hint="@string/hint_new_password"
        android:inputType="textPassword"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/launcher_text_primary"
        android:textColorHint="@color/launcher_text_secondary"
        android:maxLines="1" />

    <EditText
        android:id="@+id/setupConfirmInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_search_pill"
        android:hint="@string/hint_confirm_password"
        android:inputType="textPassword"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textColor="@color/launcher_text_primary"
        android:textColorHint="@color/launcher_text_secondary"
        android:maxLines="1" />

    <CheckBox
        android:id="@+id/useBiometricCheckbox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/enable_biometric_label"
        android:textColor="@color/launcher_text_primary" />

</LinearLayout>